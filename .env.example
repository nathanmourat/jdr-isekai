# Copier ce fichier en « .env.local » pour activer le mode en ligne quand vous lancez le jeu sur votre ordinateur.
# Les deux valeurs se trouvent dans Supabase : Project Settings → API.
# La clé « anon » est publique par conception (la sécurité est assurée par les règles RLS de supabase/schema.sql).
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique
